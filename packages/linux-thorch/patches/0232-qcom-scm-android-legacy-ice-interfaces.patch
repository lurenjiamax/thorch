From: Thorch Android storage adaptation
Subject: [PATCH] qcom scm android legacy ice interfaces

Based on OnePlus SM8550 source c462ef8ffab7a58e035ee04705b16cdfced494b1.
Adds capability queries and explicit CE programming/clear interfaces.
ICE logs capabilities only; no legacy key mode is enabled by this patch.

diff --git a/drivers/firmware/qcom/qcom_scm.h b/drivers/firmware/qcom/qcom_scm.h
--- a/drivers/firmware/qcom/qcom_scm.h
+++ b/drivers/firmware/qcom/qcom_scm.h
@@ -133,6 +133,8 @@
 #define QCOM_SCM_SVC_ES			0x10	/* Enterprise Security */
 #define QCOM_SCM_ES_INVALIDATE_ICE_KEY	0x03
 #define QCOM_SCM_ES_CONFIG_SET_ICE_KEY	0x04
+#define QCOM_SCM_ES_CONFIG_SET_ICE_KEY_V2	0x05
+#define QCOM_SCM_ES_CLEAR_ICE_KEY		0x06
 #define QCOM_SCM_ES_DERIVE_SW_SECRET	0x07
 #define QCOM_SCM_ES_GENERATE_ICE_KEY	0x08
 #define QCOM_SCM_ES_PREPARE_ICE_KEY	0x09
diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -1577,6 +1577,79 @@
 	return ret;
 }
 EXPORT_SYMBOL_GPL(qcom_scm_ice_set_key);
+
+/* Android SM8550 ABI, from Qualcomm's public crypto-qti/scm implementation. */
+u32 qcom_scm_legacy_ice_capabilities(void)
+{
+	u32 caps = 0;
+
+	if (!qcom_scm_is_available())
+		return 0;
+	if (__qcom_scm_is_call_available(__scm->dev, QCOM_SCM_SVC_ES,
+					QCOM_SCM_ES_CONFIG_SET_ICE_KEY_V2))
+		caps |= QCOM_SCM_LEGACY_ICE_SET_KEY;
+	if (__qcom_scm_is_call_available(__scm->dev, QCOM_SCM_SVC_ES,
+					QCOM_SCM_ES_CLEAR_ICE_KEY))
+		caps |= QCOM_SCM_LEGACY_ICE_CLEAR_KEY;
+	if (__qcom_scm_is_call_available(__scm->dev, QCOM_SCM_SVC_ES,
+					QCOM_SCM_ES_DERIVE_SW_SECRET))
+		caps |= QCOM_SCM_LEGACY_ICE_DERIVE_SECRET;
+	return caps;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_legacy_ice_capabilities);
+
+int qcom_scm_legacy_ice_set_key(u32 index, const u8 *key, u32 key_size,
+			      enum qcom_scm_ice_cipher cipher,
+			      u32 data_unit_size, u32 ce)
+{
+	struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_ES,
+		.cmd = QCOM_SCM_ES_CONFIG_SET_ICE_KEY_V2,
+		.arginfo = QCOM_SCM_ARGS(6, QCOM_SCM_VAL, QCOM_SCM_RW,
+					 QCOM_SCM_VAL, QCOM_SCM_VAL,
+					 QCOM_SCM_VAL, QCOM_SCM_VAL),
+		.args[0] = index,
+		.args[2] = key_size,
+		.args[3] = cipher,
+		.args[4] = data_unit_size,
+		.args[5] = ce,
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+	void *keybuf;
+	int ret;
+
+	if (!key || !key_size || key_size > 128)
+		return -EINVAL;
+	if (!(qcom_scm_legacy_ice_capabilities() & QCOM_SCM_LEGACY_ICE_SET_KEY))
+		return -EOPNOTSUPP;
+	keybuf = qcom_tzmem_alloc(__scm->mempool, key_size, GFP_KERNEL);
+	if (!keybuf)
+		return -ENOMEM;
+	memcpy(keybuf, key, key_size);
+	desc.args[1] = qcom_tzmem_to_phys(keybuf);
+	ret = qcom_scm_call(__scm->dev, &desc, NULL);
+	memzero_explicit(keybuf, key_size);
+	qcom_tzmem_free(keybuf);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_legacy_ice_set_key);
+
+int qcom_scm_legacy_ice_clear_key(u32 index, u32 ce)
+{
+	struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_ES,
+		.cmd = QCOM_SCM_ES_CLEAR_ICE_KEY,
+		.arginfo = QCOM_SCM_ARGS(2),
+		.args[0] = index,
+		.args[1] = ce,
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+
+	if (!(qcom_scm_legacy_ice_capabilities() & QCOM_SCM_LEGACY_ICE_CLEAR_KEY))
+		return -EOPNOTSUPP;
+	return qcom_scm_call(__scm->dev, &desc, NULL);
+}
+EXPORT_SYMBOL_GPL(qcom_scm_legacy_ice_clear_key);
 
 bool qcom_scm_has_wrapped_key_support(void)
 {
diff --git a/include/linux/firmware/qcom/qcom_scm.h b/include/linux/firmware/qcom/qcom_scm.h
--- a/include/linux/firmware/qcom/qcom_scm.h
+++ b/include/linux/firmware/qcom/qcom_scm.h
@@ -120,6 +120,15 @@
 int qcom_scm_ice_set_key(u32 index, const u8 *key, u32 key_size,
 			 enum qcom_scm_ice_cipher cipher, u32 data_unit_size);
 bool qcom_scm_has_wrapped_key_support(void);
+/* Legacy Android interfaces take an explicit crypto-engine selector. */
+#define QCOM_SCM_LEGACY_ICE_SET_KEY BIT(0)
+#define QCOM_SCM_LEGACY_ICE_CLEAR_KEY BIT(1)
+#define QCOM_SCM_LEGACY_ICE_DERIVE_SECRET BIT(2)
+u32 qcom_scm_legacy_ice_capabilities(void);
+int qcom_scm_legacy_ice_set_key(u32 index, const u8 *key, u32 key_size,
+			      enum qcom_scm_ice_cipher cipher,
+			      u32 data_unit_size, u32 ce);
+int qcom_scm_legacy_ice_clear_key(u32 index, u32 ce);
 int qcom_scm_derive_sw_secret(const u8 *eph_key, size_t eph_key_size,
 			      u8 *sw_secret, size_t sw_secret_size);
 int qcom_scm_generate_ice_key(u8 *lt_key, size_t lt_key_size);
diff --git a/drivers/soc/qcom/ice.c b/drivers/soc/qcom/ice.c
--- a/drivers/soc/qcom/ice.c
+++ b/drivers/soc/qcom/ice.c
@@ -150,6 +150,9 @@
 	if (ice->hwkm_version)
 		dev_info(dev, "QC Hardware Key Manager (HWKM) version v%d\n",
 			 ice->hwkm_version);
+	/* Probe only: do not program keys or switch ICE mode based on this. */
+	dev_info(dev, "Android legacy ICE SCM capabilities: %#x\n",
+		 qcom_scm_legacy_ice_capabilities());
 
 	/* If fuses are blown, ICE might not work in the standard way. */
 	regval = qcom_ice_readl(ice, QCOM_ICE_REG_FUSE_SETTING);
