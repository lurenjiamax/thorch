From: Thorch Android storage adaptation
Subject: [PATCH] Opt-in Thor HWKM-v2 legacy SCM and TME broadcast

Uses the Thor vendor ABI and pinned Qualcomm SM8550 HWKM initialization.
TME remains an external module; no new storage keys are generated.

diff --git a/drivers/soc/qcom/ice.c b/drivers/soc/qcom/ice.c
--- a/drivers/soc/qcom/ice.c
+++ b/drivers/soc/qcom/ice.c
@@ -13,6 +13,7 @@
 #include <linux/delay.h>
 #include <linux/device.h>
 #include <linux/iopoll.h>
+#include <linux/module.h>
 #include <linux/of.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
@@ -104,6 +105,12 @@
 MODULE_PARM_DESC(use_wrapped_keys,
 		 "Support wrapped keys instead of raw keys, if available on the platform");
 
+static bool qcom_ice_android_legacy_hwkm;
+module_param_named(android_legacy_hwkm, qcom_ice_android_legacy_hwkm, bool, 0444);
+MODULE_PARM_DESC(android_legacy_hwkm, "Opt into Thor Android HWKM-v2 SCM/TME ABI");
+
+extern int aynthor_tme_broadcast_transport_key(void);
+
 struct qcom_ice {
 	struct device *dev;
 	void __iomem *base;
@@ -113,6 +120,8 @@
 	bool use_hwkm;
 	bool hwkm_init_complete;
 	u8 hwkm_version;
+	bool android_legacy_hwkm;
+	u8 crypto_cap_idx;
 };
 
 static DEFINE_XARRAY(ice_handles);
@@ -180,7 +188,22 @@
 	 * advertise support for raw keys or wrapped keys, HWKM cannot be used
 	 * unconditionally.  A module parameter is used to opt into using it.
 	 */
-	if (ice->hwkm_version && qcom_scm_has_wrapped_key_support()) {
+	if (qcom_ice_android_legacy_hwkm) {
+		u32 required = QCOM_SCM_LEGACY_ICE_SET_KEY |
+			       QCOM_SCM_LEGACY_ICE_CLEAR_KEY |
+			       QCOM_SCM_LEGACY_ICE_DERIVE_SECRET;
+
+		if (!of_machine_is_compatible("ayn,thor") ||
+		    ice->hwkm_version != QCOM_ICE_HWKM_V2 ||
+		    !qcom_ice_use_wrapped_keys ||
+		    (qcom_scm_legacy_ice_capabilities() & required) != required) {
+			dev_err(dev, "Android legacy HWKM opt-in prerequisites not met\n");
+			return false;
+		}
+		ice->android_legacy_hwkm = true;
+		ice->use_hwkm = true;
+		dev_info(dev, "Using Thor Android HWKM-v2; TME broadcast required\n");
+	} else if (ice->hwkm_version && qcom_scm_has_wrapped_key_support()) {
 		if (qcom_ice_use_wrapped_keys) {
 			dev_info(dev, "Using HWKM. Supporting wrapped keys only.\n");
 			ice->use_hwkm = true;
@@ -263,9 +286,17 @@
 static void qcom_ice_hwkm_init(struct qcom_ice *ice)
 {
 	u32 regval;
+	int (*broadcast)(void) = NULL;
 
 	if (!ice->use_hwkm)
 		return;
+	if (ice->android_legacy_hwkm) {
+		broadcast = symbol_get(aynthor_tme_broadcast_transport_key);
+		if (!broadcast) {
+			dev_warn_ratelimited(ice->dev, "TME provider not loaded; HWKM stays uninitialized\n");
+			return;
+		}
+	}
 
 	BUILD_BUG_ON(QCOM_ICE_HWKM_MAX_WRAPPED_KEY_SIZE >
 		     BLK_CRYPTO_MAX_HW_WRAPPED_KEY_SIZE);
@@ -302,6 +333,27 @@
 	/* Clear the HWKM response FIFO. */
 	qcom_ice_writel(ice, QCOM_ICE_HWKM_RSP_FIFO_CLEAR_VAL,
 			QCOM_ICE_REG_HWKM_BANK0_BANKN_IRQ_STATUS);
+	if (broadcast) {
+		u32 ctl = qcom_ice_readl(ice, HWKM_OFFSET + 0x101c);
+		int err;
+
+		/* Qualcomm HWKM-v2: enable slave reception, broadcast retained TP
+		 * key through TME, then disable reception. Never generate a key.
+		 */
+		qcom_ice_writel(ice, ctl & ~BIT(8), HWKM_OFFSET + 0x101c);
+		qcom_ice_writel(ice, 0x18c, HWKM_OFFSET + 0x101c);
+		wmb();
+		err = broadcast();
+		ctl = qcom_ice_readl(ice, HWKM_OFFSET + 0x101c);
+		qcom_ice_writel(ice, ctl & ~BIT(8), HWKM_OFFSET + 0x101c);
+		wmb();
+		symbol_put(aynthor_tme_broadcast_transport_key);
+		if (err) {
+			dev_err_ratelimited(ice->dev, "TME transport-key broadcast failed: %d\n", err);
+			return;
+		}
+		dev_info(ice->dev, "TME transport-key broadcast succeeded\n");
+	}
 	ice->hwkm_init_complete = true;
 }
 
@@ -366,16 +419,30 @@
 		return -EINVAL;
 	}
 	if (!ice->hwkm_init_complete) {
+		if (ice->android_legacy_hwkm)
+			qcom_ice_hwkm_init(ice);
+	}
+	if (!ice->hwkm_init_complete) {
 		dev_err_ratelimited(dev, "HWKM not yet initialized\n");
 		return -EINVAL;
 	}
 
 	/* Clear CFGE before programming the key. */
 	qcom_ice_writel(ice, 0x0, QCOM_ICE_REG_CRYPTOCFG(slot));
+	wmb();
 
 	/* Call into TrustZone to program the wrapped key using HWKM. */
-	err = qcom_scm_ice_set_key(translate_hwkm_slot(ice, slot), bkey->bytes,
+	if (ice->android_legacy_hwkm) {
+		if (bkey->size != QCOM_ICE_HWKM_WRAPPED_KEY_SIZE(QCOM_ICE_HWKM_V2))
+			return -EINVAL;
+		cfg.capidx = ice->crypto_cap_idx;
+		/* Thor's crypto-qti-hwkm module ABI: slot*2, cipher/dusize/CE=0. */
+		err = qcom_scm_legacy_ice_set_key(slot * 2, bkey->bytes,
+						bkey->size, 0, 0, 0);
+	} else {
+		err = qcom_scm_ice_set_key(translate_hwkm_slot(ice, slot), bkey->bytes,
 				   bkey->size, cfg.capidx, cfg.dusize);
+	}
 	if (err) {
 		dev_err_ratelimited(dev,
 				    "qcom_scm_ice_set_key failed; err=%d, slot=%u\n",
@@ -386,6 +453,7 @@
 	/* Set CFGE after programming the key. */
 	qcom_ice_writel(ice, le32_to_cpu(cfg.regval),
 			QCOM_ICE_REG_CRYPTOCFG(slot));
+	wmb();
 	return 0;
 }
 
@@ -438,11 +506,22 @@
 
 int qcom_ice_evict_key(struct qcom_ice *ice, int slot)
 {
+	if (ice->android_legacy_hwkm) {
+		qcom_ice_writel(ice, 0, QCOM_ICE_REG_CRYPTOCFG(slot));
+		wmb();
+		return qcom_scm_legacy_ice_clear_key(slot * 2, 0);
+	}
 	if (ice->hwkm_init_complete)
 		slot = translate_hwkm_slot(ice, slot);
 	return qcom_scm_ice_invalidate_key(slot);
 }
 EXPORT_SYMBOL_GPL(qcom_ice_evict_key);
+
+void qcom_ice_set_crypto_cap_idx(struct qcom_ice *ice, u8 index)
+{
+	ice->crypto_cap_idx = index;
+}
+EXPORT_SYMBOL_GPL(qcom_ice_set_crypto_cap_idx);
 
 /**
  * qcom_ice_get_supported_key_type() - Get the supported key type
@@ -499,6 +578,8 @@
 			  u8 lt_key[BLK_CRYPTO_MAX_HW_WRAPPED_KEY_SIZE])
 {
 	int err;
+	if (ice->android_legacy_hwkm)
+		return -EOPNOTSUPP;
 
 	err = qcom_scm_generate_ice_key(lt_key,
 					QCOM_ICE_HWKM_WRAPPED_KEY_SIZE(ice->hwkm_version));
@@ -526,6 +607,8 @@
 			 u8 eph_key[BLK_CRYPTO_MAX_HW_WRAPPED_KEY_SIZE])
 {
 	int err;
+	if (ice->android_legacy_hwkm)
+		return -EOPNOTSUPP;
 
 	err = qcom_scm_prepare_ice_key(lt_key, lt_key_size,
 				       eph_key, QCOM_ICE_HWKM_WRAPPED_KEY_SIZE(ice->hwkm_version));
@@ -554,6 +637,8 @@
 			u8 lt_key[BLK_CRYPTO_MAX_HW_WRAPPED_KEY_SIZE])
 {
 	int err;
+	if (ice->android_legacy_hwkm)
+		return -EOPNOTSUPP;
 
 	err = qcom_scm_import_ice_key(raw_key, raw_key_size,
 				      lt_key, QCOM_ICE_HWKM_WRAPPED_KEY_SIZE(ice->hwkm_version));
diff --git a/drivers/ufs/host/ufs-qcom.c b/drivers/ufs/host/ufs-qcom.c
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -212,9 +213,11 @@
 						       REG_UFS_CRYPTOCAP +
 						       i * sizeof(__le32)));
 		if (cap.algorithm_id == UFS_CRYPTO_ALG_AES_XTS &&
-		    cap.key_size == UFS_CRYPTO_KEY_SIZE_256)
+		    cap.key_size == UFS_CRYPTO_KEY_SIZE_256) {
+			qcom_ice_set_crypto_cap_idx(ice, i);
 			profile->modes_supported[BLK_ENCRYPTION_MODE_AES_256_XTS] |=
 				cap.sdus_mask * 512;
+		}
 	}
 
 	hba->caps |= UFSHCD_CAP_CRYPTO;
diff --git a/include/soc/qcom/ice.h b/include/soc/qcom/ice.h
--- a/include/soc/qcom/ice.h
+++ b/include/soc/qcom/ice.h
@@ -17,6 +17,7 @@
 int qcom_ice_program_key(struct qcom_ice *ice, unsigned int slot,
 			 const struct blk_crypto_key *blk_key);
 int qcom_ice_evict_key(struct qcom_ice *ice, int slot);
+void qcom_ice_set_crypto_cap_idx(struct qcom_ice *ice, u8 index);
 enum blk_crypto_key_type qcom_ice_get_supported_key_type(struct qcom_ice *ice);
 int qcom_ice_derive_sw_secret(struct qcom_ice *ice,
 			      const u8 *eph_key, size_t eph_key_size,
