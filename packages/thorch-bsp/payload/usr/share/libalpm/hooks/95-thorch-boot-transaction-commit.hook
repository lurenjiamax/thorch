[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = linux-thorch
Target = mkinitcpio
Target = thorch-bsp
Target = mkinitcpio-git

# Match mkinitcpio's path triggers, including system-library-only updates.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/lib/systemd/systemd-udevd
Target = usr/bin/cryptsetup
Target = usr/bin/lvm
Target = usr/bin/mdadm
Target = usr/bin/pdata_tools
Target = usr/lib/libcryptsetup.so
Target = usr/lib/libp11-kit.so
Target = usr/lib/libpcsclite.so
Target = usr/lib/modprobe.d/

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Building and validating the updated Thorch boot payload...
When = PostTransaction
Exec = /usr/lib/thorch/boot-transaction commit
