pkgname=thorch-tme-modules
pkgver=7.1.2
pkgrel=40
pkgdesc='Experimental Thor SM8550 TME transport modules for linux-thorch'
arch=('aarch64')
url='https://github.com/lurenjiamax/thorch'
license=('GPL-2.0-only')
depends=('linux-thorch=7.1.2-39' 'kmod')
options=('!strip' '!debug')

package() {
  local release='7.1.2-thorch39' module
  local artifacts="${THORCH_TME_MODULE_DIR:?CI module artifacts required}"
  for module in aynthor_qmp aynthor_tme tme_overlay_loader; do
    [[ "$(modinfo -F vermagic "${artifacts}/${module}.ko")" == "${release} "* ]] || return 1
    install -Dm644 "${artifacts}/${module}.ko" \
      "${pkgdir}/usr/lib/modules/${release}/updates/aynthor/${module}.ko"
  done
  install -Dm644 "${artifacts}/tme-overlay.dtbo" \
    "${pkgdir}/usr/lib/firmware/aynthor/tme-overlay.dtbo"
  install -Dm644 "${artifacts}/PROVENANCE" \
    "${pkgdir}/usr/share/doc/${pkgname}/PROVENANCE"
}
